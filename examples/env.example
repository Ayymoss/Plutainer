# Copy to .env next to your docker-compose.yml. Never commit it.
#
#   cp examples/env.example .env
#
# docker compose reads .env automatically and substitutes ${NAME} in the
# compose file.

# Plutonium server keys — one per server, from
# https://platform.plutonium.pw/serverkeys
# Required for t4/t5/t6/iw5. T5 in particular will not load a map without a
# valid one.
T4MP_KEY=
T4ZM_KEY=
T5MP_KEY=
T5ZM_KEY=
T6MP_KEY=
T6ZM_KEY=
IW5MP_KEY=

# RCON passwords. Optional, but RCON (and IW4MAdmin) stay disabled without
# them. Use a different one per server.
T6MP_RCON=
T6ZM_RCON=
IW4X_RCON=
COD4X_RCON=

# SteamCMD games. On 7DTD this is the telnet console password (setting it also
# turns the console on); on Source games it is rcon_password.
SEVENDTD_RCON=
CS2_RCON=
L4D2_RCON=
HL2DM_RCON=

# CoD4x masterserver token, 32 characters, from http://cod4master.cod4x.ovh
# The server runs without it but never registers with the master, so it does
# not show up in the in-game server browser.
COD4X_TOKEN=

# CS2 Game Server Login Token, from
# https://steamcommunity.com/dev/managegameservers
# The server runs without it but never appears in the server browser.
CS2_GSLT=

# Optional Nebula passwords. The first protects joining; the second enables
# authenticated /server commands through an in-game client.
NEBULA_SERVER_PASSWORD=
NEBULA_REMOTE_PASSWORD=

# "latest" checks Thunderstore at every server start; use e.g. 0.9.22 to pin.
NEBULA_VERSION=latest
NEBULA_MODS=
# Example: NEBULA_MODS=Owner-Package:latest,Owner-OtherPackage:1.2.3
